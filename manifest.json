{
  "dxt_version": "0.1",
  "name": "@beeper/mcp-remote",
  "display_name": "Beeper Desktop MCP",
  "version": "0.0.1",
  "description": "Beeper Desktop MCP gives Claude access to all your messages and chats across 10+ chat networks.",
  "author": {
    "name": "Beeper",
    "email": "help@beeper.com",
    "url": "https://www.beeper.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beeper/mcp-remote"
  },
  "homepage": "https://www.beeper.com/mcp",
  "documentation": "https://developers.beeper.com/desktop-api/mcp",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "dist/proxy.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/proxy.js",
        "${user_config.beeper_desktop_base_url}/v0/mcp",
        "--transport",
        "http-only",
        "--static-oauth-client-metadata",
        "{ \"scope\": \"read write\" }",
        "--header",
        "Authorization: Bearer ${user_config.beeper_desktop_access_token}",
        "--debug"
      ],
      "env": {
        "BEEPER_DESKTOP_ACCESS_TOKEN": "${user_config.beeper_desktop_access_token}",
        "MCP_REMOTE_CONFIG_DIR": "${__dirname}/.mcp-auth",
        "HOME": "${HOME}"
      }
    }
  },
  "tools_generated": true,
  "keywords": [
    "beeper",
    "messages",
    "chat",
    "messages",
    "send",
    "read",
    "unread",
    "history",
    "communication",
    "automation"
  ],
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "user_config": {
    "beeper_desktop_base_url": {
      "type": "string",
      "title": "Beeper Desktop Base URL",
      "description": "Base URL for Beeper Desktop API. You don't need to change this if you're using the default port (23373).",
      "required": false,
      "default": "http://localhost:23373"
    },
    "beeper_desktop_access_token": {
      "type": "string",
      "title": "Beeper Desktop access token (optional)",
      "description": "Override the access token to skip the OAuth flow. Leave empty to use the automated flow.",
      "sensitive": true,
      "required": false
    }
  }
}
