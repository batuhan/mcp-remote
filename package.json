{
  "name": "@beeper/mcp-remote",
  "version": "0.0.1",
  "description": "stdio support for Beeper Desktop's Streamable HTTP MCP server",
  "keywords": [
    "mcp",
    "stdio",
    "beeper",
    "chat",
    "messages"
  ],
  "author": "Beeper <support@beeper.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beeper/desktop-mcp-relayer"
  },
  "homepage": "https://www.beeper.com/mcp",
  "documentation": "https://developers.beeper.com/desktop-api/mcp",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "bin": {
    "beeper-desktop-mcp": "dist/proxy.js"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "check": "prettier --check . && tsc",
    "lint-fix": "prettier --check . --write",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "postbuild": "rimraf BeeperDesktopMCP.dxt && dxt pack . BeeperDesktopMCP.dxt"
  },
  "dependencies": {
    "express": "^4.21.2",
    "open": "^10.1.0",
    "strict-url-sanitise": "^0.0.1",
    "undici": "^7.12.0",
    "mcp-remote": "github:geelen/mcp-remote#ce68351da4991bb795c2cccb94bf3649e5843cf4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.3",
    "@anthropic-ai/dxt": "0.2.6",
    "rimraf": "6.0.1"
  },
  "tsup": {
    "entry": [
      "src/client.ts",
      "src/proxy.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "outDir": "dist",
    "external": []
  },
  "vitest": {
    "environment": "node",
    "globals": true,
    "include": [
      "src/**/*.test.ts"
    ]
  }
}
